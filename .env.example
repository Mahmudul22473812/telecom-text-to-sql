# Local development uses Ollama. Set this to gemini in public hosting.
AI_PROVIDER=ollama
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Hosted AI configuration (required only when AI_PROVIDER=gemini)
GEMINI_API_KEY=replace_with_a_secret
GEMINI_CHAT_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# A hosted deployment should use its pooled, SSL-enabled PostgreSQL URL.
# DATABASE_URL=postgresql://user:password@host-pooler/dbname?sslmode=require
# DATABASE_ADMIN_URL is used only by the import/role setup scripts.
# DATABASE_ADMIN_URL=postgresql://owner:password@direct-host/dbname?sslmode=require
# APP_DB_USER=telecom_reader
# APP_DB_PASSWORD=replace_with_a_different_strong_secret
DB_NAME=telecom
DB_USER=postgres
DB_PASSWORD=replace_with_a_secret
DB_HOST=localhost
DB_PORT=5432
DB_CONNECT_TIMEOUT=10
DB_STATEMENT_TIMEOUT_MS=15000
