# Paste these values into Streamlit Community Cloud's Secrets settings.
# Never rename this example to secrets.toml and commit the real values.

AI_PROVIDER = "gemini"
GEMINI_API_KEY = "replace_with_your_google_ai_studio_key"
GEMINI_CHAT_MODEL = "gemini-3.6-flash"
GEMINI_EMBEDDING_MODEL = "gemini-embedding-001"

# Use Neon's pooled connection string for the running application.
DATABASE_URL = "postgresql://user:password@host-pooler/dbname?sslmode=require"
DB_CONNECT_TIMEOUT = "10"
DB_STATEMENT_TIMEOUT_MS = "15000"
